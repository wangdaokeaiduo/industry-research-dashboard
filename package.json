{
  "name": "industry-research-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server.mjs --dev",
    "build": "vite build",
    "start": "node server.mjs",
    "reports:docs": "node scripts/generate-report-docs.mjs",
    "research:sync": "node scripts/sync-tushare-research.mjs",
    "report:optical": "node scripts/build-optical-module-report.mjs",
    "report:mlcc": "node scripts/build-mlcc-report.mjs",
    "report:gold": "node scripts/build-gold-report.mjs",
    "report:innovative-drug": "node scripts/build-innovative-drug-report.mjs",
    "report:pharmacy-chain": "node scripts/build-pharmacy-chain-report.mjs",
    "report:memory-chip": "node scripts/build-memory-chip-report.mjs",
    "report:pcb": "node scripts/build-pcb-report.mjs",
    "report:food-beverage": "node scripts/build-food-beverage-report.mjs",
    "report:power": "node scripts/build-power-report.mjs",
    "report:yaoyigou": "node scripts/build-yaoyigou-report.mjs && npm run reports:docs",
    "report:yixintang": "node scripts/build-yixintang-report.mjs && npm run reports:docs",
    "test": "node --test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {}
}
